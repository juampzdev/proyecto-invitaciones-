# Copiá este archivo como ".env" y completá los valores.

# Conexión a PostgreSQL. Ejemplos:
#   Local:          postgres://postgres:postgres@localhost:5432/cartitas
#   Neon/Supabase:  la "connection string" que te da el panel (termina en ?sslmode=require)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cartitas

# Opcionales
# PORT=3000
# PUBLIC_URL=https://tudominio.com
# PAYMENT_MODE=demo
